type Student {
    id: ID!
    name: String!
    age: Int!
    email: String!
    cgpa: Float
}

input StudentInput {
    name: String!
    age: Int!
    email: String!
    cgpa: Float
}

type Query {
    student(id: ID!): Student
    students: [Student!]!
}

type Mutation {
    createStudent(student: StudentInput!): Student
    updateStudent(id:ID!,student:StudentInput!):Student
    deleteStudent(id:ID!):Boolean!
}