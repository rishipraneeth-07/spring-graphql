type Student {
    id: ID!
    name: String!
    age: Int!
    email: String!
    cgpa: Float
    department: Department
}

type Department {
    id: ID!
    name: String!
    hod: String
    building: String
    students: [Student!]!
}

input StudentInput {
    name: String!
    age: Int!
    email: String!
    cgpa: Float
}

type StudentPage {
    content: [Student!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
    pageSize: Int!
    first: Boolean!
    last: Boolean!
}

type Query {
    student(id: ID!): Student
    students(page: Int!, size: Int!,sortBy: StudentSortField!,direction: SortDirection!
    ): StudentPage!
}

type Mutation {
    createStudent(student: StudentInput!): Student
    updateStudent(id:ID!,student:StudentInput!):Student
    deleteStudent(id:ID!):Boolean!
}

enum StudentSortField {
    ID
    NAME
    AGE
    EMAIL
    CGPA
}

enum SortDirection {
    ASC
    DESC
}